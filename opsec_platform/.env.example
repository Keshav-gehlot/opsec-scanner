# Copy to .env and fill in real values. Never commit the filled-in file.

# --- Session signing (required) ---
# A long random string. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
PLATFORM_JWT_SECRET=

# How long an issued session stays valid before needing to log in again.
PLATFORM_SESSION_TTL_MINUTES=480

# --- Database ---
# SQLite is fine for evaluation/small deployments. For anything real,
# point this at Postgres: postgresql://user:pass@host:5432/dbname
PLATFORM_DATABASE_URL=sqlite:///./platform.db

# --- Deployment ---
# Must match where this is actually reachable — used to build OAuth
# callback URLs. No trailing slash.
PLATFORM_BASE_URL=http://localhost:8000

# Session cookies are Secure (HTTPS-only) by default, which is correct
# for any real deployment. Only set this to false for local development
# over plain http://localhost — never in production.
PLATFORM_COOKIE_SECURE=true

# --- OAuth / SSO providers ---
# Every one of these is optional — a provider with no client_id/secret
# set is simply unavailable (the login route returns a clear "not
# configured" error instead of a broken redirect). See README.md in
# this directory for exactly how to obtain each of these from the
# provider's own developer console; none of them can be generated for
# you, they're tied to an app registration only you control.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Apple's "client secret" is not a static string — it's a JWT you
# generate yourself, signed with a private key from your Apple Developer
# account, and it expires after at most 6 months (see README for the
# generation script and a reminder to rotate it before expiry).
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
