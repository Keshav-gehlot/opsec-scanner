# Copy to .env and fill in real values. Never commit the filled-in file.

# --- Session signing (required) ---
# A long random string. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
PLATFORM_JWT_SECRET=

# How long an issued session stays valid before needing to log in again.
PLATFORM_SESSION_TTL_MINUTES=480

# --- Abuse limits (optional; defaults shown) ---
# Login: per-account and per-client-IP failed attempts within a window.
# PLATFORM_LOGIN_RATE_LIMIT_ATTEMPTS=5
# PLATFORM_LOGIN_IP_RATE_LIMIT_ATTEMPTS=20
# Registration attempts (successful or rejected) per client IP.
# PLATFORM_REGISTER_RATE_LIMIT_ATTEMPTS=10
# PLATFORM_REGISTER_RATE_LIMIT_WINDOW_MINUTES=60

# --- Optional first admin ---
# Created on startup if missing. In HTTPS deployments the password must be
# >= 12 characters, not contain the email's local part, and not be
# repetitive; a weak value is refused and, if the existing account still
# uses it, that account's password login is disabled. Changing this value
# rotates the password (and revokes the account's sessions). Remove both
# once you have your own admin account.
# PLATFORM_BOOTSTRAP_ADMIN_EMAIL=
# PLATFORM_BOOTSTRAP_ADMIN_PASSWORD=

# --- Database ---
# SQLite is fine for evaluation/small deployments. For anything real,
# point this at Postgres: postgresql://user:pass@host:5432/dbname
PLATFORM_DATABASE_URL=sqlite:///./platform.db

# Signs the short-lived OAuth state cookie (opsec_oauth). REQUIRED for
# SSO in any HTTPS deployment (PLATFORM_COOKIE_SECURE=true); must be at
# least 32 bytes and different from PLATFORM_JWT_SECRET and every OAuth
# client secret. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Optional for plain-http local development (an ephemeral key is used).
PLATFORM_OAUTH_SESSION_SECRET=

# --- Deployment ---
# The public origin users sign in through — used to build OAuth callback
# URLs, which must exactly match the provider's registered redirect URIs.
# REQUIRED for SSO in HTTPS deployments (must be https://); never derived
# from request headers there. Production: https://opsec-scanner-seven.vercel.app
# No trailing slash.
PLATFORM_BASE_URL=http://localhost:8000

# Session cookies are Secure (HTTPS-only) by default, which is correct
# for any real deployment. Only set this to false for local development
# over plain http://localhost — never in production.
PLATFORM_COOKIE_SECURE=true

# --- OAuth / SSO providers ---
# Every one of these is optional — a provider with no client_id/secret
# set is simply unavailable (the login route returns a clear "not
# configured" error instead of a broken redirect). See README.md in
# this directory for exactly how to obtain each of these from the
# provider's own developer console; none of them can be generated for
# you, they're tied to an app registration only you control.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Apple's "client secret" is not a static string — it's a JWT you
# generate yourself, signed with a private key from your Apple Developer
# account, and it expires after at most 6 months (see README for the
# generation script and a reminder to rotate it before expiry).
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ---------------------------------------------------------------------
# Web workspace scanning (all optional; defaults shown)
# ---------------------------------------------------------------------
# Server-side scans of uploaded media and public git URLs. Set to false to
# accept only CLI/JSON result imports.
PLATFORM_WEB_SCANS_ENABLED=true
PLATFORM_SCAN_MAX_CONCURRENT=2
PLATFORM_SCAN_DAILY_LIMIT=30
PLATFORM_SCAN_MEDIA_MAX_FILES=20
PLATFORM_SCAN_MEDIA_MAX_FILE_MB=10
PLATFORM_SCAN_MEDIA_MAX_TOTAL_MB=25
PLATFORM_SCAN_IMPORT_MAX_MB=10
PLATFORM_SCAN_IMPORT_MAX_FINDINGS=10000
PLATFORM_SCAN_GIT_DEFAULT_DEPTH=200
PLATFORM_SCAN_GIT_MAX_DEPTH=1000
PLATFORM_SCAN_GIT_MAX_MB=200
PLATFORM_SCAN_GIT_TIMEOUT_SECONDS=120
PLATFORM_SCAN_GIT_HOSTS=github.com,gitlab.com,bitbucket.org,codeberg.org
PLATFORM_API_TOKEN_MAX_DAYS=365
# Key for finding fingerprints (HMAC). Defaults to one derived from
# PLATFORM_JWT_SECRET; set it separately if you rotate the JWT secret and
# want new/resolved comparisons to keep working across the rotation.
PLATFORM_FINGERPRINT_SECRET=
